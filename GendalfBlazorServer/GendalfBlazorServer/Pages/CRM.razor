@page "/crm"
@using GendalfBlazorServer.DTO
@using GendalfBlazorServer.Services
@inject ClientService ClientApi
@inject OperatorService OperatorApi

<h3>Панель управления (Gendalf CRM)</h3>

<div class="row">
    <div class="col-md-6">
        <div class="card p-3">
            <h4 class="text-primary">Клиенты (Микросервис 1)</h4>

            <div class="mb-3 p-2 border rounded">
                <h5>Новый клиент</h5>
                <div class="mb-2">
                    <input class="form-control" placeholder="Имя" @bind="formClient.ClientName" />
                </div>
                <div class="mb-2">
                    <input class="form-control" placeholder="Фамилия" @bind="formClient.ClientSurname" />
                </div>
                <button class="btn btn-primary btn-sm" @onclick="SaveClient">Добавить</button>
            </div>

            @if (clients == null)
            {
                <p>Загрузка клиентов...</p>
            }
            else if (!clients.Any())
            {
                <p>Список клиентов пуст.</p>
            }
            else
            {
                @foreach (var c in clients)
                {
                    <div class="p-2 my-2 border-start border-primary border-4 bg-light d-flex justify-content-between align-items-center">
                        <div>
                            <strong>@c.ClientName @c.ClientSurname</strong><br />
                            <small class="text-muted">Баланс: @c.Balance руб.</small>
                        </div>
                        <span class="badge @(c.Online ? "bg-success" : "bg-secondary")">
                            @(c.Online ? "Online" : "Offline")
                        </span>
                    </div>
                }
            }
        </div>
    </div>

    <div class="col-md-6">
        <div class="card p-3">
            <h4 class="text-success">Операторы (Микросервис 2)</h4>

            <div class="mb-3 p-2 border rounded">
                <h5>Новый оператор</h5>
                <div class="mb-2">
                    <input class="form-control" placeholder="Имя" @bind="formOperator.OperatorName" />
                </div>
                <div class="mb-2">
                    <input class="form-control" placeholder="Фамилия" @bind="formOperator.OperatorSurname" />
                </div>
                <button class="btn btn-success btn-sm" @onclick="SaveOperator">Добавить</button>
            </div>

            @if (operators == null)
            {
                <p>Загрузка операторов...</p>
            }
            else if (!operators.Any())
            {
                <p>Список операторов пуст.</p>
            }
            else
            {
                @foreach (var o in operators)
                {
                    <div class="p-2 my-2 border-start border-success border-4 bg-light d-flex justify-content-between align-items-center">
                        <div>
                            <strong>@o.OperatorName @o.OperatorSurname</strong><br />
                            <small class="text-muted">Статус: @(o.OperatorIsBusy ? "Занят" : "Свободен")</small>
                        </div>
                        <span class="badge @(o.Online ? "bg-success" : "bg-secondary")">
                            @(o.Online ? "Online" : "Offline")
                        </span>
                    </div>
                }
            }
        </div>
    </div>
</div>

@code {
    private List<ClientDto>? clients;
    private List<OperatorDto>? operators;

    private ClientDto formClient = new() { Online = true };
    private OperatorDto formOperator = new() { Online = true, OperatorIsBusy = false };

    protected override async Task OnInitializedAsync()
    {
        await RefreshLists();
    }

    private async Task RefreshLists()
    {
        try
        {
            clients = await ClientApi.GetClients();
            operators = await OperatorApi.GetOperators();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Ошибка при получении данных: {ex.Message}");
        }
    }

    private async Task SaveClient()
    {
        if (string.IsNullOrWhiteSpace(formClient.ClientName)) return;

        await ClientApi.CreateClient(formClient);

        formClient = new ClientDto() { Online = true };
        clients = await ClientApi.GetClients();
    }

    private async Task SaveOperator()
    {
        if (string.IsNullOrWhiteSpace(formOperator.OperatorName)) return;

        await OperatorApi.CreateOperator(formOperator);

        formOperator = new OperatorDto() { Online = true, OperatorIsBusy = false };
        operators = await OperatorApi.GetOperators();
    }
}